#!/bin/bash

## Copyright (C) 2012 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Calculate version information and the determine the locations of various
## build artifacts. These have to be together because build artifact location
## depends on both flavor-resolved variables and version info.

## style-ok: no-strict -- sourced fragment.
## style-ok: no-has -- early bootstrap.
# shellcheck disable=SC2086

## Get the ref (branch or commit) that we're currently at.
##
## Unconditionally recompute from 'git rev-parse HEAD'. There isn't a
## plausible situation where being able to customize this is useful.
dist_build_current_git_head="$("${git_bin}" rev-parse --end-of-options HEAD)" || error 'Cannot get head commit ID!'

#printf "%s\n" "dist_build_current_git_head: $dist_build_current_git_head"

if [ "${dist_build_version:-}" = "" ]; then
   ## --always because tags might not be present.
   ## Examples dist_build_version:
   ## 10-13-g20e1b49ff27053784e3e9e163dfd4c98dced73f5
   ## 10.0.0.0.3-13-g20e1b49ff27053784e3e9e163dfd4c98dced73f5-developers-only
   ##
   ## --exclude skips help-steps/sign-tag-head's ephemeral signing tags.
   dist_build_version="$("${git_bin}" describe --always --abbrev=1000000000 --exclude '*_*_*')"
   true "${cyan}INFO: Variable dist_build_version was unset. Auto detected. Set to: dist_build_version=${dist_build_version}${reset}"
else
   true "${cyan}INFO: Variable dist_build_version was already set to: dist_build_version=${dist_build_version}${reset}"

   ## CI exports dist_build_version to specify a particular commit in buildinfo
   ## metadata, but also runs sign-and-tag which amends commits and overwrites
   ## the commit mentioned in the version string. This is fine, but AI agents
   ## have caused the same situation unintentionally during local work, so warn
   ## when this happens.
   dist_build_version_described="${dist_build_version##*-g}"
   ## Non-hex means this is not a describe suffix (a tag may contain '-g').
   if ! [[ "${dist_build_version_described}" =~ ^[0-9a-f]{40}$ ]]; then
      dist_build_version_described=""
   fi
   if [ -n "${dist_build_version_described}" ]; then
      dist_build_version_head="$("${git_bin}" rev-parse --verify HEAD 2>/dev/null || true)"
      if [ -n "${dist_build_version_head}" ] \
         && [ ! "${dist_build_version_described}" = "${dist_build_version_head}" ]; then
         true "${red}${bold}WARNING: dist_build_version describes commit ${dist_build_version_described}, but HEAD is ${dist_build_version_head}. This should only ever happen in CI.${reset}"
      fi
   fi
fi

## --reproducible-dist-build-version: drop the git describe suffix
## '-<n>-g<commit>', leaving the nearest tag.
if [ "${dist_build_version_reproducible:-}" = "true" ]; then
   dist_build_version_normalized="$("${git_bin}" describe --always --abbrev=0 --exclude '*_*_*')"
   if [ "${dist_build_version_normalized}" = "${dist_build_version}" ]; then
      true "${cyan}INFO: --reproducible-dist-build-version: '${dist_build_version}' carries no describe suffix; unchanged.${reset}"
   else
      true "${cyan}INFO: --reproducible-dist-build-version: normalized '${dist_build_version}' -> '${dist_build_version_normalized}'.${reset}"
      ## dm-reproducible-buildinfo records the pre-normalization version too.
      export dist_build_version_unnormalized="${dist_build_version}"
      dist_build_version="${dist_build_version_normalized}"
   fi
fi

## Strip channel suffixes ('-developers-only', '-testers-only', '-stable')
## that may be attached to the git tag so that 'dist_build_version' is a
## clean version string regardless of which release channel we are on.
dist_build_version="$(printf "%s\n" "${dist_build_version}" | sed -E "s#-(developers-only|testers-only|stable)##g")"

value_charset_ok "${dist_build_version}" 'A-Za-z0-9._-' || error "dist_build_version must be non-empty and [A-Za-z0-9._-]."

export dist_build_version

## Example dist_build_version:
## 10.0.0.0.3-13-g20e1b49ff27053784e3e9e163dfd4c98dced73f5

default_if_empty dist_binary_build_folder "${binary_build_folder_dist}/${dist_build_version}"

## Sanity test. dm-prepare-release uses 'rm --force --recursive'.
## XXX: hardcoded derivative-binary
## dist_build_version is validated to ensure it contains no '/' above, so
## dist_binary_build_folder can't contain any accidental path traversal.
if ! printf "%s\n" "${dist_binary_build_folder}" | grep --fixed-strings -- "derivative-binary" >/dev/null 2>&1; then
   printf "%s\n" "$0: FAIL: wrong folder: dist_binary_build_folder: ${dist_binary_build_folder}"
   exit 1
fi

default_if_empty binary_image_raw_file "${dist_binary_build_folder}/${SHORT_VMNAME}-${dist_build_desktop}-${dist_build_version}.${target_architecture_pretty_name}.raw"
default_if_empty binary_image_qcow2_file "${dist_binary_build_folder}/${SHORT_VMNAME}-${dist_build_desktop}-${dist_build_version}.${target_architecture_pretty_name}.qcow2"

default_if_empty base_image_raw_file "${dist_binary_build_folder}/base-image.raw"
if [ "${dist_build_base_image_role:-}" = "create" ]; then
   binary_image_raw_file="${base_image_raw_file}"
elif [ "${dist_build_base_image_role:-}" = "consume" ]; then
   cached_binary_image_raw_file="${base_image_raw_file}"
fi

## If doing a unified build, determine the location of the should-already-exist
## VM image.
derive_unified_image_paths

default_if_empty binary_image_ova_file "${dist_binary_build_folder}/${dist_unified_name}-${dist_build_version}.${target_architecture_pretty_name}.ova"
default_if_empty binary_image_iso_file "${dist_binary_build_folder}/${SHORT_VMNAME}-${dist_build_desktop}-${dist_build_version}.${target_architecture_pretty_name}.iso"
default_if_empty binary_image_windows_installer_file "${dist_binary_build_folder}/${dist_unified_name}-${dist_build_version}.exe"
default_if_empty libvirt_target_raw_xz_archive_file "${dist_binary_build_folder}/${dist_unified_name}-${dist_build_version}.${target_architecture_pretty_name}.raw.libvirt.xz"
default_if_empty libvirt_target_qcow2_xz_archive_file "${dist_binary_build_folder}/${dist_unified_name}-${dist_build_version}.${target_architecture_pretty_name}.qcow2.libvirt.xz"
default_if_empty source_archive_xz_file "${dist_binary_build_folder}/${dist_unified_name}-${dist_build_version}.xz"
default_if_empty binary_image_text "${dist_binary_build_folder}/${SHORT_VMNAME}-${dist_build_desktop}-${dist_build_version}.text"

## virtualbox-installer / dist-installer-cli
default_if_empty binary_image_installer_dist_source "${source_code_folder_dist}/packages/kicksecure/usability-misc/usr/share/usability-misc/dist-installer-cli-standalone"
default_if_empty binary_image_installer_dist_file "${dist_binary_build_folder}/dist-installer-cli"

default_if_empty libvirt_source_kvm_file "${source_code_folder_dist}/packages/kicksecure/libvirt-dist/usr/share/libvirt-dist/xml/${SHORT_VMNAME}.xml"
default_if_empty libvirt_target_kvm_file "${dist_binary_build_folder}/${SHORT_VMNAME}.xml"

default_if_empty source_utm_file "${source_code_folder_dist}/packages/kicksecure/libvirt-dist/usr/share/utm/${SHORT_VMNAME}.plist.template"
default_if_empty binary_image_utm_folder "${dist_binary_build_folder}/${SHORT_VMNAME}-${dist_build_desktop}.utm"

default_if_empty libvirt_source_network_file_external "${source_code_folder_dist}/packages/kicksecure/libvirt-dist/usr/share/libvirt-dist/xml/Whonix-External.xml"
default_if_empty libvirt_target_network_file_external "${dist_binary_build_folder}/Whonix_external_network.xml"

default_if_empty libvirt_source_network_file_internal "${source_code_folder_dist}/packages/kicksecure/libvirt-dist/usr/share/libvirt-dist/xml/Whonix-Internal.xml"
default_if_empty libvirt_target_network_file_internal "${dist_binary_build_folder}/Whonix_internal_network.xml"

# TODO: broken
default_if_empty copy_vms_into_raw_file_one "${dist_binary_build_folder}/Whonix-Gateway-${dist_build_desktop}-${dist_build_version}.qcow2"
default_if_empty copy_vms_into_raw_file_two "${dist_binary_build_folder}/Whonix-Workstation-${dist_build_desktop}-${dist_build_version}.qcow2"

default_if_empty binary_iso_pkg_repo_dir "${dist_binary_build_folder}/iso-pkg-repo"
