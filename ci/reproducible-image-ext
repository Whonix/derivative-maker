## AI-Assisted

## Resolve the RELEASED-image filename extension for a build target (from the
## shared reproducible-target-map.bsh) and export it as REPRO_IMAGE_EXT to the
## GitHub Actions env, so the reproducibility lane's upload step grabs only that
## file. Kept as a ci/ script (github-actions-security.md rule 7 -- no inline
## workflow scripting) so it is shellcheck / 'bash -n' covered and runnable
## locally; run outside CI (GITHUB_ENV unset) it just prints the extension.
##
## Usage: ci/reproducible-image-ext TARGET   (iso|virtualbox|raw|qcow2|utm)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

target="${1:-}"
if [ -z "${target}" ]; then
   printf '%s\n' "${BASH_SOURCE[0]}: usage: ci/reproducible-image-ext TARGET" >&2
   exit 2
fi

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
# shellcheck source=../packages/kicksecure/developer-meta-files/usr/libexec/developer-meta-files/reproducible-target-map.bsh
source "${MYDIR}/../packages/kicksecure/developer-meta-files/usr/libexec/developer-meta-files/reproducible-target-map.bsh"

image_ext=""
if ! dm_reproducible_target_ext image_ext "${target}"; then
   printf '%s\n' "${BASH_SOURCE[0]}: unsupported target: '${target}'" >&2
   exit 1
fi

## In CI, hand the extension to later steps via the env file; always echo it too
## so a local run (GITHUB_ENV unset) is useful and testable.
if [ -n "${GITHUB_ENV:-}" ]; then
   printf 'REPRO_IMAGE_EXT=%s\n' "${image_ext}" >> "${GITHUB_ENV}"
fi
printf '%s\n' "${image_ext}"
