## AI-Assisted

## Compare the disk/ISO image produced by two independent builds for
## reproducibility. Given two build-output directories (each the uploaded
## '$HOME/binary_mnt' tree of one build job), locate the single largest image
## in each and hand the pair to 'help-steps/reproducible-compare', applying the
## expected-to-differ allowlist. Kept as a lint-covered, locally runnable script
## (repo convention) so the reproducibility CI lane's YAML stays a thin caller.
##
## Usage:
##   ci/reproducible-compare-artifacts \
##      --target TARGET --dir-a DIR --dir-b DIR --output REPORT [--allowlist FILE]
##
##   --target TARGET   the build target whose image to compare; selects the
##                     image by EXTENSION (not by size). Required, because the
##                     ISO build leaves BOTH the intermediate '.raw' disk and
##                     the final '.iso' in the output tree, and a size-based
##                     pick would silently compare the raw image instead of the
##                     released ISO. Mapping:
##                       virtualbox -> .ova    iso   -> .iso    raw -> .raw
##                       qcow2      -> .qcow2  utm   -> .utm
##
## Exit codes (passed through from reproducible-compare / diffoscope):
##   0  the two images are identical (reproducible)
##   1  differences remain after the allowlist (NOT reproducible yet)
##   2  usage / environment error (e.g. no image found)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 2
}

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
repo_root="$( cd -- "${MYDIR}/.." && pwd )"

target=""
dir_a=""
dir_b=""
output_file=""
allowlist_file="${repo_root}/help-steps/reproducible-allowlist.conf"

while [ "$#" -gt 0 ]; do
   case "${1:-}" in
      --target)     [ "$#" -ge 2 ] || error "--target requires a value."; target="$2"; shift 2 ;;
      --dir-a)      [ "$#" -ge 2 ] || error "--dir-a requires a value."; dir_a="$2"; shift 2 ;;
      --dir-b)      [ "$#" -ge 2 ] || error "--dir-b requires a value."; dir_b="$2"; shift 2 ;;
      --output)     [ "$#" -ge 2 ] || error "--output requires a value."; output_file="$2"; shift 2 ;;
      --allowlist)  [ "$#" -ge 2 ] || error "--allowlist requires a value."; allowlist_file="$2"; shift 2 ;;
      *)            error "unknown argument: '$1'." ;;
   esac
done

[ -n "${target}" ]      || error "--target is required."
[ -n "${dir_a}" ]       || error "--dir-a is required."
[ -n "${dir_b}" ]       || error "--dir-b is required."
[ -n "${output_file}" ] || error "--output is required."
[ -d "${dir_a}" ]       || error "--dir-a is not a directory: '${dir_a}'"
[ -d "${dir_b}" ]       || error "--dir-b is not a directory: '${dir_b}'"

## Map the build target to the extension of the image it releases. The ISO
## build in particular leaves both the intermediate '.raw' disk and the final
## '.iso' in the output tree, so the image MUST be chosen by target/extension,
## never by size (the raw can be larger than the ISO).
case "${target}" in
   virtualbox) image_ext="ova" ;;
   iso)        image_ext="iso" ;;
   raw)        image_ext="raw" ;;
   qcow2)      image_ext="qcow2" ;;
   utm)        image_ext="utm" ;;
   *)          error "unsupported --target '${target}' (expected virtualbox|iso|raw|qcow2|utm)." ;;
esac

## Locate the release image for the requested target: the file with the target's
## extension. If more than one matches (it should not), pick the largest so
## trailing intermediates never win. 'nullglob' so a missing extension yields
## nothing; 'globstar' to descend the version subfolder. No subshell / no find.
find_image() {
   local search_dir wanted_ext image_candidate best_image best_size candidate_size
   search_dir="$1"
   wanted_ext="$2"
   best_image=""
   best_size="-1"

   local -a image_candidates=()
   local saved_nullglob saved_globstar
   saved_nullglob="$( shopt -p nullglob )" || true
   saved_globstar="$( shopt -p globstar )" || true
   shopt -s nullglob globstar
   image_candidates=( "${search_dir}"/**/*."${wanted_ext}" )
   ## Restore the caller's glob options.
   eval "${saved_nullglob}"
   eval "${saved_globstar}"

   for image_candidate in "${image_candidates[@]}"; do
      [ -f "${image_candidate}" ] || continue
      candidate_size="$( stat --format='%s' -- "${image_candidate}" )"
      if [ "${candidate_size}" -gt "${best_size}" ]; then
         best_size="${candidate_size}"
         best_image="${image_candidate}"
      fi
   done

   [ -n "${best_image}" ] || error "no '.${wanted_ext}' image (target '${target}') found under '${search_dir}'."
   printf '%s\n' "${best_image}"
}

image_a="$( find_image "${dir_a}" "${image_ext}" )"
image_b="$( find_image "${dir_b}" "${image_ext}" )"

printf '%s\n' "INFO: image A: ${image_a}" >&2
printf '%s\n' "INFO: image B: ${image_b}" >&2

## Pass through reproducible-compare's exit code unchanged so the CI lane's job
## conclusion IS the reproducibility pass/fail signal.
compare_exit="0"
"${repo_root}/help-steps/reproducible-compare" \
   --allowlist "${allowlist_file}" \
   --output "${output_file}" \
   "${image_a}" \
   "${image_b}" \
   || compare_exit="$?"

exit "${compare_exit}"
