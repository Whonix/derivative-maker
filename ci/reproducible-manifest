## AI-Assisted

## Generate, sign and compare a per-image reproducibility MANIFEST: a sorted
## 'sha256  path' list of an image's contents.
##
## Rationale: diffoscope on two multi-gigabyte images is RAM/disk-heavy (it OOMs
## an 8 GB host on two ~1.4 GB ISOs). A signed manifest of a RELEASED image lets a
## third party regenerate the same manifest from their own reproduction and diff
## the two manifests -- cheap, streaming, no OOM -- to prove (non-)reproducibility.
## diffoscope is then only needed to EXPLAIN a mismatch the manifest localizes.
## This complements the per-package '.buildinfo' (inputs) with a per-image output
## fingerprint. See help-steps/reproducible-compare (diffoscope path).
##
## Usage:
##   ci/reproducible-manifest generate --image FILE --output MANIFEST [--deep] [--sign KEYID]
##   ci/reproducible-manifest compare  --a MANIFEST --b MANIFEST [--output REPORT]
##
## generate: mounts the image read-only and lists every regular file as
##   'sha256  relative/path', sorted by path (stable, diff-friendly). '--deep' also
##   descends into any 'filesystem.squashfs' member (unsquashfs -> hash the rootfs,
##   paths prefixed 'squashfs:<member>!'); omit it on a small host (extraction needs
##   disk). '--sign KEYID' additionally writes 'MANIFEST.asc' (gpg detached sig).
## compare: prints files only in A, only in B, and content-differing (same path,
##   different sha); exit 0 if identical, 1 if any difference, 2 on usage error.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit

## style-ok: no-has

## Cleanup state (globals so the single EXIT trap can reach them regardless of
## which subcommand ran or where an error aborted).
manifest_mount_point=""
manifest_work_dir=""

cleanup() {
   if [ -n "$manifest_mount_point" ]; then
      sudo --non-interactive umount --lazy -- "$manifest_mount_point" 2>/dev/null || true
      rmdir -- "$manifest_mount_point" 2>/dev/null || true
   fi
   if [ -n "$manifest_work_dir" ]; then
      sudo --non-interactive rm --recursive --force -- "$manifest_work_dir" 2>/dev/null || true
   fi
}
trap cleanup EXIT

usage() {
   printf '%s\n' "Usage:
  ${0##*/} generate --image FILE --output MANIFEST [--deep] [--sign KEYID]
  ${0##*/} compare  --a MANIFEST --b MANIFEST [--output REPORT]" >&2
   exit 2
}

## Hash every regular file under a directory as 'sha256  <prefix><relative-path>',
## sorted by path. Uses sudo because image trees contain root-owned, 0700 entries.
##
## Hashing is BATCHED: one 'sudo bash -c' does the whole tree via 'find -print0 | xargs -0
## sha256sum', instead of a 'sudo sha256sum' per file. Per-file was ~56 files/sec -- 70+ minutes
## for a ~140k-file rootfs -- because each file paid a fresh sudo + process spawn; batching brings a
## full rootfs to ~2 minutes. NUL-delimited find|xargs keeps paths with spaces intact (sha256sum
## only escapes names containing a backslash or newline, which system images do not have). The
## per-file relative path from 'find .' is './rel'; strip the leading './' and prepend the prefix.
manifest_tree() {
   local root="$1" prefix="$2" line sha rel
   sudo --non-interactive bash -c 'cd -- "$1" || exit 1; find . -type f -print0 | xargs -0 -r sha256sum' _ "$root" \
      | while IFS='' read -r line; do
           sha="${line%%  *}"
           rel="${line#*  }"
           rel="${rel#./}"
           printf '%s  %s%s\n' "$sha" "$prefix" "$rel"
        done \
      | LC_ALL=C sort --key=2
}

do_generate() {
   local image="" output="" deep="false" sign_key="" sqfs work_parent=""
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --image) image="${2:-}" ; shift 2 ;;
         --output) output="${2:-}" ; shift 2 ;;
         --deep) deep="true" ; shift ;;
         --sign) sign_key="${2:-}" ; shift 2 ;;
         *) printf '%s\n' "${0##*/}: unexpected argument: $1" >&2 ; usage ;;
      esac
   done
   if [ -z "$image" ] || [ -z "$output" ]; then
      usage
   fi
   if [ ! -f "$image" ]; then
      printf '%s\n' "${0##*/}: no such image: $image" >&2
      exit 2
   fi

   manifest_mount_point="$(mktemp --directory)"
   sudo --non-interactive mount --options loop,ro -- "$image" "$manifest_mount_point"

   ## Image-level manifest (always).
   manifest_tree "$manifest_mount_point" "" > "$output"

   ## Optional descent into the compressed rootfs.
   if [ "$deep" = "true" ]; then
      ## Extract next to the OUTPUT manifest (caller-chosen, normally /home), NOT the default
      ## $TMPDIR: a rootfs unsquashfs is >1 GiB and the default /tmp is often a small tmpfs that
      ## ENOSPC-truncates the extraction (and thus the manifest) silently.
      work_parent="$(dirname -- "$output")"
      while IFS='' read -r sqfs; do
         manifest_work_dir="$(mktemp --directory --tmpdir="$work_parent")"
         ## Defense-in-depth: 'set -o errexit' already aborts on a mktemp failure, but guard the
         ## value explicitly so an empty one can never reach 'unsquashfs -dest' below as
         ## '-dest /root' -- a root-owned extraction that could corrupt the host's /root.
         [ -n "$manifest_work_dir" ] || { printf '%s\n' "${0##*/}: mktemp failed in $work_parent" >&2; exit 1; }
         ## No '--' before "$sqfs": unsquashfs has no end-of-options separator and treats a literal
         ## '--' as the FILESYSTEM argument (prints SYNTAX and extracts nothing -> empty manifest).
         sudo --non-interactive unsquashfs -no-progress -dest "$manifest_work_dir/root" "$sqfs" >/dev/null
         manifest_tree "$manifest_work_dir/root" "squashfs:${sqfs#"$manifest_mount_point"/}!" >> "$output"
         sudo --non-interactive rm --recursive --force -- "$manifest_work_dir"
         manifest_work_dir=""
      done < <(sudo --non-interactive find "$manifest_mount_point" -type f -name '*.squashfs')
      LC_ALL=C sort --output "$output" -- "$output"
   fi

   printf '%s\n' "wrote manifest: $output ($(wc -l < "$output") entries)"

   if [ -n "$sign_key" ]; then
      gpg --local-user "$sign_key" --armor --detach-sign --output "$output.asc" -- "$output"
      printf '%s\n' "wrote signature: $output.asc"
   fi
}

## Reformat a manifest to 'path<TAB>sha' sorted by path (for comm/join).
manifest_to_keyed() {
   ## Manifest line is 'sha  path' (two-space separator); path may contain spaces.
   sed -E 's/^([0-9a-f]+)  (.*)$/\2\t\1/' -- "$1" | LC_ALL=C sort
}

do_compare() {
   local man_a="" man_b="" report="" tab tmp_a tmp_b only_a only_b changed
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --a) man_a="${2:-}" ; shift 2 ;;
         --b) man_b="${2:-}" ; shift 2 ;;
         --output) report="${2:-}" ; shift 2 ;;
         *) printf '%s\n' "${0##*/}: unexpected argument: $1" >&2 ; usage ;;
      esac
   done
   if [ -z "$man_a" ] || [ -z "$man_b" ]; then
      usage
   fi
   if [ ! -f "$man_a" ] || [ ! -f "$man_b" ]; then
      printf '%s\n' "${0##*/}: manifest not found" >&2
      exit 2
   fi

   tab="$(printf '\t')"
   tmp_a="$(mktemp)" ; tmp_b="$(mktemp)"
   manifest_to_keyed "$man_a" > "$tmp_a"
   manifest_to_keyed "$man_b" > "$tmp_b"

   only_a="$(LC_ALL=C comm -23 <(cut -f1 "$tmp_a") <(cut -f1 "$tmp_b") | wc -l)"
   only_b="$(LC_ALL=C comm -13 <(cut -f1 "$tmp_a") <(cut -f1 "$tmp_b") | wc -l)"
   changed="$(LC_ALL=C join -t "$tab" "$tmp_a" "$tmp_b" | awk -F"$tab" '$2!=$3{print $1}' | wc -l)"

   local body
   body="$(
      printf '%s\n' "reproducibility manifest comparison"
      printf '  only in A: %s\n' "$only_a"
      printf '  only in B: %s\n' "$only_b"
      printf '  content differs (same path): %s\n' "$changed"
      if [ "$changed" -gt 0 ]; then
         printf '%s\n' "  differing paths:"
         LC_ALL=C join -t "$tab" "$tmp_a" "$tmp_b" | awk -F"$tab" '$2!=$3{print "    " $1}'
      fi
      LC_ALL=C comm -23 <(cut -f1 "$tmp_a") <(cut -f1 "$tmp_b") | sed 's/^/  only-A: /'
      LC_ALL=C comm -13 <(cut -f1 "$tmp_a") <(cut -f1 "$tmp_b") | sed 's/^/  only-B: /'
   )"
   printf '%s\n' "$body"
   if [ -n "$report" ]; then
      printf '%s\n' "$body" > "$report"
   fi

   rm --force -- "$tmp_a" "$tmp_b"

   if [ "$only_a" -eq 0 ] && [ "$only_b" -eq 0 ] && [ "$changed" -eq 0 ]; then
      printf '%s\n' "RESULT: identical (reproducible)"
      exit 0
   fi
   printf '%s\n' "RESULT: differences remain (not bit-reproducible)"
   exit 1
}

case "${1:-}" in
   generate) shift ; do_generate "$@" ;;
   compare)  shift ; do_compare  "$@" ;;
   *) usage ;;
esac
