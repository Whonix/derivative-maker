## AI-Assisted

## dm-maintenance: thin dispatcher for periodic maintenance tasks on the derivative-maker source
## tree. Each task's logic lives in its OWN script (help-steps/<task>); this wrapper only parses the
## task name + shared options and runs the matching script, forwarding its exit code. Add a task by
## dropping in help-steps/<task> and a case branch below.
##
## Tasks (first positional argument):
##   update-frozen-snapshot   Bump the pinned snapshot.debian.org timestamp in
##                            build_sources/debian_stable_frozen_clearnet.sources to the newest valid
##                            snapshot. Implemented by help-steps/update-frozen-snapshot.
##
## Options:
##   --dry-run                Passed through to the task (show what would change; write nothing).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## style-ok: no-has -- standalone operator tool; does not source derivative-maker helper-scripts.

MYDIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
   cat -- <<'EOF'
Usage: dm-maintenance [--dry-run] <task>

Tasks:
  update-frozen-snapshot   Bump the pinned snapshot.debian.org timestamp to the newest snapshot
                           that still serves the pinned suite (build_sources/*_frozen_*.sources).

Options:
  --dry-run                Show what would change; write nothing.
  --help, -h               This help.
EOF
}

## Shared options accumulate into forwarded_args and are passed on to the task script unchanged.
forwarded_args=()
task=''
while [ "$#" -gt 0 ]; do
   case "$1" in
      --dry-run)
         forwarded_args+=(--dry-run)
         shift
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      --)
         shift
         break
         ;;
      -*)
         printf 'dm-maintenance: unknown option: %s\n' "$1" >&2
         exit 2
         ;;
      *)
         task="$1"
         shift
         break
         ;;
   esac
done

case "${task}" in
   update-frozen-snapshot)
      "${MYDIR}/help-steps/update-frozen-snapshot" "${forwarded_args[@]}"
      ;;
   '')
      printf 'dm-maintenance: no task given\n' >&2
      usage >&2
      exit 2
      ;;
   *)
      printf 'dm-maintenance: unknown task: %s\n' "${task}" >&2
      usage >&2
      exit 2
      ;;
esac
