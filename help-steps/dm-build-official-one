## Official multi-flavor build orchestrator.
##
## Layout:
## - Phase 1: per-flavor sanity tests.
## - Phase 2: shared one-time work (build machine, cowbuilder, local
##   dependencies, base raw image, derivative packages) -- runs exactly once
##   for the whole flavor matrix.
## - Phase 3: per-flavor image builds. Each reuses Phase 2's shared work via
##   first-class '--skip-*' switches (owned by the individual build steps) plus
##   the cached base raw image, so the expensive shared work is never repeated.
## - Phase 4: source release + image upload.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "$0: START"

## Print the command instead of running it, for auditing this orchestrator.
## Reachable via 'TESTING_MODE=1' (environment) or the '--show-steps' argument.
run_cmd() {
  [ -n "${TESTING_MODE:-}" ] || TESTING_MODE=0
  if [ "${TESTING_MODE:-0}" -eq 1 ]; then
    set +x
    printf '%s\n' "$*"
  else
    "$@"
  fi
}

true "INFO: 0: $0"

## '--show-steps' is an alias for 'TESTING_MODE=1'. Filtered out of the
## forwarded arguments because the downstream build steps do not know it.
forwarded_args=()
for arg_item in "$@"; do
  if [ "$arg_item" = "--show-steps" ]; then
    TESTING_MODE=1
    export TESTING_MODE
  else
    forwarded_args+=("$arg_item")
  fi
done
set -- ${forwarded_args[@]+"${forwarded_args[@]}"}

if [ "${CI:-}" = "true" ]; then
  true "INFO: Skipping test if folder ~/.ssh exists on CI."
elif [ "${build_dry_run:-}" = "true" ]; then
  ## '--dry-run true' is documented (see 'help-steps/parse-cmd') as
  ## "useful for debugging dm-prepare-release"; rsync is mocked
  ## (see 'help-steps/variables' '$rsync_cmd' default for dry-run),
  ## so '~/.ssh' is not used for real uploads and its absence is not
  ## an error. Coordinated with
  ## 'build-steps.d/1100_sanity-tests'
  ## 'check-redistributable-builds-requirements()'.
  true "INFO: Skipping test if folder ~/.ssh exists in dry-run mode."
else
  run_cmd test -d ~/.ssh
fi

## architecture choice
## - If environment variable 'dist_build_target_arch' is set, honor it.
## - On CI, build ARM64 by default since it is the most recent architecture port.
## - Official builds default to Intel/AMD64 at the time of writing.
build_args=()
if ! [ "${dist_build_target_arch:-}" = "" ]; then
  architecture="$dist_build_target_arch"
elif [ "${CI:-}" = "true" ]; then
  architecture=arm64
  ## Build the Kicksecure/Whonix derivative packages from source rather than
  ## pulling prebuilt ones from the remote repository: a CI (stage) build must be
  ## reproducible, and a reproducible image must not embed opaque prebuilt
  ## packages. Trade-off: slower (compiles all derivative packages).
  build_args+=(--remote-derivative-packages false)
  export dist_build_upgrade_build_machine=1
else
  architecture="amd64"
fi
build_args+=(--arch "$architecture")

## Ordered as follows for the following reasons:
## - 1) Build '--flavor kicksecure-lxqt' because building ISO, which is newer,
##      therefore more prone to build issues. Error out quicker is better.
## - 2) Build '--flavor whonix-gateway-lxqt' because it is required to be able to
##      run dm-prepare-release due to unified ova files.
## - 3) Build '--flavor whonix-workstation-lxqt' because it is the most
##      complex, because of downloading Tor Browser as well as when used with
##      '--target windows', because:
## - *_prepare-build-machine downloads VirtualBox-*-Win.exe
## - dm-prepare-release builds Whonix Windows Installer
## - 4) Build CLI flavors because these are the least likely to have build issues.
##
## NOTE: Fewer flavors are build on CI. If 'CI=true', 'help-steps/parse-cmd'
##       will inject 'build_dry_run="true"' (equivalent of '--dry-run true').
[ -n "${flavors_list:-}" ] || flavors_list=(
  kicksecure-lxqt
  kicksecure-cli
  whonix-gateway-lxqt
  whonix-workstation-lxqt
  whonix-gateway-cli
  whonix-workstation-cli
)

## True if $1 is one of the flavors this run actually built. The hardcoded
## source-release / upload steps below name specific flavors (kicksecure-lxqt,
## whonix-workstation-lxqt); skip them when a reduced flavors_list (e.g. a
## flavors_list=kicksecure-cli CI smoke build) did not build that flavor, so a
## single-flavor run does not fail preparing a release for an image it never made.
flavor_built() {
  printf '%s\n' "${flavors_list[@]}" | grep -qxF -- "$1"
}

build_upload_noninteractive=true
export build_upload_noninteractive

dist_build_redistributable=true
export dist_build_redistributable

if [ "${dist_build_redistributable:-}" = "true" ]; then
  build_args+=(--repo true)
  build_args+=(--tb closed)
  ## Install package 'firmware-nonfreedom' by default.
  ## - Applicable to '--arch' 'amd64' only
  ## - Applicable to for ISO builds only.
  ## See also:
  ## https://www.kicksecure.com/wiki/Dev/nonfree
  build_args+=(--freedom false)
fi

if printf '%s\n' "$@" | grep -- "remote-derivative-packages true" &>/dev/null; then
  remote_derivative_packages=true
fi

if printf '%s\n' "${build_args[*]}" | grep -- "remote-derivative-packages true" &>/dev/null; then
  remote_derivative_packages=true
fi

if [ "${remote_derivative_packages:-}" = "true" ] || [ "${CI:-}" = "true" ]; then
  ## Skip upload of debug images, and never upload from CI (a stage build). This
  ## is independent of remote-derivative-packages so that disabling it above (for
  ## a reproducible from-source CI build) cannot enable a real upload.
  rsync_cmd="true simulate-only"
  export rsync_cmd
fi

## Shared build-machine + base-image target scope: ALWAYS the per-arch default.
## The sanity-tests, prepare-build-machine, cowbuilder-setup, local-dependencies,
## the shared base raw image (create-raw-image requires at least one --target) and
## the package build run ONCE for the whole flavor matrix, so they must carry the
## full target set regardless of the per-flavor VM-image selection below.
multi_target_args=()
case "${architecture:-}" in
  amd64)
    ## VirtualBox ova + qcow2. (amd64 for Windows, Linux, Mac)
    multi_target_args+=("--target" "virtualbox")
    multi_target_args+=("--target" "qcow2")
  ;;
  arm64)
    ## Only qcow2 for now; VirtualBox arm64 (Mac M1/M2) disabled pending CI.
    multi_target_args+=("--target" "qcow2")
  ;;
  *)
    ## '--target qcow2' might be the most universal.
    multi_target_args+=("--target" "qcow2")
  ;;
esac

## Per-flavor VM image build+upload scope: 'dist_build_multi_target_list' (a
## space-separated target list) overrides this when SET (even to empty). Empty
## means "build only the ISO for this flavor" -- e.g. an ISO-only CI boot-test leg
## whose qcow2/VirtualBox images come from a sibling job (the raw->vdi->ova + qcow2
## build after the ISO would exhaust the runner disk). Unset -> same as the shared
## default above. Only the per-flavor build/upload honor this; the shared steps
## above keep the full default so the build machine and base image are prepared.
flavor_multi_target_args=()
if [ -n "${dist_build_multi_target_list+x}" ]; then
  for multi_target_item in ${dist_build_multi_target_list}; do
    flavor_multi_target_args+=("--target" "$multi_target_item")
  done
else
  flavor_multi_target_args=("${multi_target_args[@]}")
fi

## multi_target_args comment:
## Cannot mix,
## * 1) '--target iso', and,
## * 2) "${multi_target_args[@]}"
## because no ISO should be build for Whonix-Gateway, Whonix-Workstation.
## (Maybe in the future for Whonix-Host.)
## The ISO should only be built for Kicksecure-LXQt for now.

############################################################
## Phase 1: per-flavor sanity tests.
############################################################

for flavor_item in "${flavors_list[@]}"; do
  ## Not yet using multi_target_args as the sanity test for Whonix-Gateway ISO would complain that the VMs
  ## have not been built yet.
  run_cmd ./build-steps.d/*_sanity-tests "${build_args[@]}" --target windows "${multi_target_args[@]}" --flavor "$flavor_item" "$@"
done

############################################################
## Phase 2: shared one-time work (runs exactly once).
############################################################

## These steps produce shared artifacts consumed by every per-flavor build in
## Phase 3, so they run once, up front, with the FULL union target set. They are
## invoked as individual build steps (rather than folded into the first
## './derivative-maker' call) on purpose:
##
## - prepare-build-machine / cowbuilder-setup / local-dependencies install
##   TARGET-SPECIFIC dependencies (verified: 1200 branches on dist_build_iso /
##   install_to_root / raw / qcow2; 1300 builds an extra amd64 chroot for
##   '--target virtualbox --arch arm64'; 1400 installs live-build for
##   '--target iso' and downloads the VirtualBox Windows installer for
##   '--target windows'). They must therefore see the UNION of targets
##   ('--target iso --target windows' + the VM targets). No single per-flavor
##   build carries that union (the first real build is Kicksecure-LXQt ISO,
##   '--target iso' only), so union prep cannot be folded into it. They also
##   must complete BEFORE the base raw image is created (grml-debootstrap etc.).
## - The base raw image must be a PURE post-debootstrap / pre-package-install
##   image so every flavor can reuse it. create-raw-image only "captures" it by
##   naming its working file 'base-image.raw' (dist_build_raw_base_image_create);
##   a full './derivative-maker' run would then install packages INTO that file
##   (3500_install-packages mounts + chroots binary_image_raw_file), polluting
##   the shared base. So the base image is created by a create-raw-image-only
##   invocation, with a concrete VM flavor+target ('--flavor source' errors in
##   create-raw-image; '--target iso' is a no-op there).
## - create-debian-packages builds all derivative .debs into the local repo once
##   (kept here with the exact union invocation so its target-conditional paths
##   match the historical behavior); Phase 3 reuses them via
##   '--skip-published-packages'. The shared build ITSELF also passes
##   '--skip-published-packages': on a cold local repo every package is absent so
##   dm_package_needs_rebuild returns true and all are built (a no-op vs. before),
##   while a warm repo (e.g. a CI cache persisted across runs) lets unchanged
##   packages be skipped -- only version-bumped or source-content-changed packages
##   rebuild. Correctness is unchanged: a real edit still rebuilds (changelog
##   version compare, else a source content hash).

## Use both '--target iso' and the VM targets for prepare-build-machine /
## cowbuilder-setup / local-dependencies, because ISO builds need additional
## dependencies (live-build) and '--target windows' triggers the VirtualBox
## Windows installer download.
run_cmd ./build-steps.d/*_prepare-build-machine "${build_args[@]}" --target iso --target windows "${multi_target_args[@]}" --flavor source "$@"
run_cmd ./build-steps.d/*_cowbuilder-setup "${build_args[@]}" --target iso --target windows "${multi_target_args[@]}" --flavor source "$@"
run_cmd ./build-steps.d/*_local-dependencies "${build_args[@]}" --target iso --target windows "${multi_target_args[@]}" --flavor source "$@"

## Create the shared base raw image once.
## '--flavor source' would lead to variable dist_build_hostname being unset (and
## create-raw-image errors on it), therefore using '--flavor kicksecure-cli'.
## '--target iso' must not be used because the ISO is created using live-build,
## not create-raw-image; create-raw-image would do nothing with '--target iso'.
export dist_build_raw_base_image_create=true
run_cmd ./build-steps.d/*_create-raw-image "${build_args[@]}" "${multi_target_args[@]}" --flavor kicksecure-cli "$@"
unset dist_build_raw_base_image_create

## '--target iso' is required to download calamares from backports.
## '--skip-published-packages' makes a warm local repo (persisted across CI runs)
## skip unchanged packages; a no-op on a cold repo (all packages absent -> built).
run_cmd ./build-steps.d/*_create-debian-packages "${build_args[@]}" --target iso "${multi_target_args[@]}" --flavor source --skip-published-packages "$@"

############################################################
## Phase 3: per-flavor image builds (reuse Phase 2's shared work).
############################################################

## Every per-flavor './derivative-maker' build reuses Phase 2's shared work:
## - '--skip-prepare-build-machine', '--skip-cowbuilder-setup' and
##   '--skip-local-dependencies' make those steps exit early (they already ran
##   in Phase 2 with the union target set).
## - '--skip-published-packages' rebuilds only packages that changed since
##   Phase 2 (none, in a single official build), reusing the local repo.
## - 'dist_build_use_cached_raw_base_image=true' makes create-raw-image copy the
##   shared base-image.raw instead of running grml-debootstrap again.
skip_shared_args=(
  --skip-prepare-build-machine
  --skip-cowbuilder-setup
  --skip-local-dependencies
  --skip-published-packages
)

dist_build_use_cached_raw_base_image=true
export dist_build_use_cached_raw_base_image

for flavor_item in "${flavors_list[@]}"; do
  case "${flavor_item:-}" in
    kicksecure-lxqt|kicksecure-debug)
      ## ISO is built for Kicksecure LXQt (the official live ISO) and for the
      ## kicksecure-debug boot-test flavor (a minimal live ISO for fast CI
      ## iteration). Not for Kicksecure CLI. Not yet for Whonix.
      true "INFO: ISO build flavor."
      run_cmd ./derivative-maker "${build_args[@]}" "${skip_shared_args[@]}" --target iso --flavor "$flavor_item" "$@"
      ;;
    *)
      true "INFO: Non-ISO build flavor."
      ;;
  esac

  ## Build this flavor's VM images unless its target list is empty (see
  ## flavor_multi_target_args / dist_build_multi_target_list above: an ISO-only leg
  ## sets it empty so only the ISO built above is produced).
  if [ "${#flavor_multi_target_args[@]}" -gt 0 ]; then
    run_cmd ./derivative-maker "${build_args[@]}" "${skip_shared_args[@]}" "${flavor_multi_target_args[@]}" --flavor "$flavor_item" "$@"
  else
    true "INFO: dist_build_multi_target_list empty: no multi-target VM image build for ${flavor_item}."
  fi
done

############################################################
## Phase 4: source release + image upload.
############################################################

## Same source code for all of the following:
## - desktop: LXQt versus CLI
## - target: Kicksecure versus Whonix.
## - architecture: all
if flavor_built "kicksecure-lxqt"; then
  run_cmd dm-prepare-release --target source --flavor "kicksecure-lxqt" "$@"
  run_cmd dm-upload-images --target source --flavor "kicksecure-lxqt" "$@"
fi
if flavor_built "whonix-workstation-lxqt"; then
  run_cmd dm-upload-images --target source --flavor "whonix-workstation-lxqt" "$@"
fi

## TODO: Windows
# if [ "${CI:-}" = "true" ]; then
# #if [ "${architecture:-}" = "amd64" ]; then
#   ## Also build the Whonix-Windows-Installer.
#   run_cmd dm-prepare-release "${build_args[@]}" --target windows --flavor whonix-workstation-lxqt
#   run_cmd dm-upload-images "${build_args[@]}" --target windows --flavor whonix-workstation-lxqt
# fi

## Uploading.
for flavor_item in "${flavors_list[@]}"; do
  if printf '%s\n' "$flavor_item" | grep -- "gateway" &>/dev/null; then
    ## Not needed for gateway due to unified images.
    continue
  fi

  case "${flavor_item:-}" in
    kicksecure-lxqt)
      true "INFO: ISO build flavor."
      run_cmd dm-upload-images "${build_args[@]}" --target iso --flavor "$flavor_item" "$@"
      ;;
    *)
      true "INFO: Non-ISO build flavor."
      ;;
  esac

  ## Upload this flavor's VM images in one call (dm-upload-images now routes each
  ## --target to its own destination via the parallel upload-location array), or
  ## skip when its target list is empty (their files were not built above).
  if [ "${#flavor_multi_target_args[@]}" -gt 0 ]; then
    run_cmd dm-upload-images "${build_args[@]}" "${flavor_multi_target_args[@]}" --flavor "$flavor_item" "$@"
  else
    true "INFO: dist_build_multi_target_list empty: no multi-target image upload for ${flavor_item}."
  fi
done

true "$0: END"
