## dm-qemu screendump boot-watcher.
##
## Drives a running qemu instance over its QMP socket to capture periodic PNG
## screendumps of the GUEST FRAMEBUFFER, and decides whether the guest reached a
## rendered greeter/desktop -- WITHOUT touching the image or needing a serial console.
##
## This is the boot-test path for the FULL firmware -> (shim ->) GRUB -> kernel ->
## userspace chain when the cmdline cannot be instrumented: qemu '-append' only works
## with '-kernel' direct boot, and a "sovereign boot" image must not be edited to add a
## serial console. So instead of reading serial, we WATCH the screen.
##
## Detection is heuristic (no OCR available): a rendered greeter/desktop is color-RICH
## and SETTLED (few pixels change between frames), whereas early boot / a text console /
## a black screen is color-poor. Two consecutive rich+settled frames => "up". Every frame
## and its metrics are saved regardless, so the operator can eyeball the result even when
## the heuristic is wrong; tune --colors-min / --diff-max from the logged numbers.
##
## Exit: 0 guest reached a greeter/desktop; 5 timed out without one; 2 on setup error.

import argparse
import json
import os
import socket
import subprocess
import sys
import time


def log(message):
    sys.stderr.write("dm-qemu-screendump-watch: " + message + "\n")
    sys.stderr.flush()


def wait_for_socket(path, deadline):
    ## qemu is started by dm-qemu just before us; the QMP socket may not exist yet.
    while time.time() < deadline:
        if os.path.exists(path):
            return True
        time.sleep(0.5)
    return False


class Qmp:
    ## Minimal QMP client: connect, read the greeting, negotiate capabilities, then issue
    ## synchronous commands (screendump returns only after qemu has written the file).
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(15)
        self.sock.connect(path)
        self.buf = b""
        self._read_json()                      # greeting
        self.command("qmp_capabilities")

    def _read_json(self):
        ## QMP messages are newline-delimited JSON objects.
        while b"\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("QMP socket closed")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        return json.loads(line.decode("utf-8", "replace"))

    def command(self, execute, arguments=None):
        message = {"execute": execute}
        if arguments:
            message["arguments"] = arguments
        self.sock.sendall((json.dumps(message) + "\n").encode("utf-8"))
        ## Skip asynchronous events; return the first reply carrying return/error.
        while True:
            reply = self._read_json()
            if "return" in reply or "error" in reply:
                return reply

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def frame_metrics(png, prev_png):
    ## colors = distinct colors in the frame (ImageMagick 'identify %k'); a rendered GUI is
    ## in the thousands, a text/black console in the tens. diff = pixels changed vs the prior
    ## frame ('compare -metric AE' with a small fuzz to ignore a blinking cursor/clock).
    try:
        colors = int(subprocess.run(
            ["identify", "-format", "%k", "--", png],
            capture_output=True, text=True, check=True).stdout.strip() or "0")
    except (subprocess.SubprocessError, ValueError):
        colors = 0
    diff = None
    if prev_png:
        proc = subprocess.run(
            ["compare", "-metric", "AE", "-fuzz", "5%", "--", prev_png, png, "null:"],
            capture_output=True, text=True)
        digits = "".join(ch for ch in proc.stderr if ch.isdigit())
        diff = int(digits) if digits else None
    return colors, diff


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--qmp", required=True)
    parser.add_argument("--outdir", required=True)
    parser.add_argument("--timeout", type=int, default=1800)
    parser.add_argument("--interval", type=int, default=15)
    parser.add_argument("--colors-min", type=int, default=200)
    parser.add_argument("--diff-max", type=int, default=2000)
    args = parser.parse_args()

    os.makedirs(args.outdir, exist_ok=True)
    deadline = time.time() + args.timeout

    if not wait_for_socket(args.qmp, min(deadline, time.time() + 60)):
        log("QMP socket never appeared: " + args.qmp)
        return 2
    try:
        qmp = Qmp(args.qmp)
    except (OSError, ConnectionError, ValueError) as exc:
        log("QMP connect failed: " + str(exc))
        return 2

    verdict = "timeout"
    prev = None
    settled = 0
    index = 0
    try:
        while time.time() < deadline:
            time.sleep(args.interval)
            png = os.path.join(args.outdir, "frame-%04d.png" % index)
            try:
                reply = qmp.command("screendump", {"filename": png, "format": "png"})
            except (OSError, ConnectionError, ValueError) as exc:
                log("screendump failed (guest may have powered off): " + str(exc))
                break
            if "error" in reply or not os.path.exists(png) or os.path.getsize(png) == 0:
                log("screendump produced no frame: " + json.dumps(reply))
                continue
            colors, diff = frame_metrics(png, prev)
            log("frame %04d colors=%d diff=%s" % (index, colors, diff))
            ## Rich AND settled (relative to the previous frame) => count toward "up".
            if colors >= args.colors_min and diff is not None and diff <= args.diff_max:
                settled += 1
                if settled >= 2:
                    verdict = "up"
                    log("reached a rendered greeter/desktop at frame %04d" % index)
                    break
            else:
                settled = 0
            prev = png
            index += 1
        ## Graceful power-off so the caller's qemu exits cleanly; ignore if already gone.
        try:
            qmp.command("system_powerdown")
        except (OSError, ConnectionError, ValueError):
            pass
    finally:
        qmp.close()

    log("RESULT: %s (%d frames in %s)" % (verdict, index + 1, args.outdir))
    return 0 if verdict == "up" else 5


if __name__ == "__main__":
    sys.exit(main())
