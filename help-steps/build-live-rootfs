## AI-Assisted

## Build ONLY the base live-ISO root filesystem with the derivative's OWN
## bootstrap toolchain (mmdebstrap), instead of letting live-build
## re-bootstrap a second, parallel root filesystem via 'lb bootstrap'. The
## result is seeded into live-build's bootstrap cache (see
## 'help-steps/lb-seed-rootfs-cache') so 'lb bootstrap' adopts it.
##
## This deliberately does the raw base creation ONLY. The package install --
## the heavy lifting -- is done by 'build-steps.d/*_create-lb-iso' against the
## adopted chroot, using the derivative's own chroot tooling (the same tooling
## the raw/VM path's 'build-steps.d/*_install-packages' uses), so live-build is
## left doing only what it is uniquely good at: the BIOS+EFI bootloader matrix,
## squashfs, and hybrid-ISO packing ('lb binary').
##
## This reads live-build's OWN generated config for the extra apt sources so
## the adopted chroot has working apt for that later install:
##   - config/archives/*.sources.chroot     -> the extra apt sources
##                                             (derivative local repo,
##                                              fasttrack, remote derivative)
##   - config/archives/*.pref.chroot        -> apt pins (e.g. calamares from
##                                             backports)
## plus the base Debian bootstrap sources the caller assembled into the
## '--base-sources' file. 'build-steps.d/*_create-lb-iso' generates all of
## that via 'lb config' before calling this.
##
## Usage:
##   build-live-rootfs --lb-dir <dir> --rootfs <dir> --base-sources <file> \
##                     --arch <arch> --suite <suite>

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

## Tolerate this script's own options in 'variables' -> 'parse-cmd'
## (source-run mode makes parse-cmd break, not exit, on unknown options).
## Same idiom as 'help-steps/analyze_image' and 'help-steps/lb-seed-rootfs-cache'.
dist_build_source_run="true"

source "$MYDIR/pre"
source "$MYDIR/variables"

lb_dir=""
rootfs_dir=""
base_sources_file=""
arch=""
suite=""

while [ "$#" -gt 0 ]; do
   case "$1" in
      --lb-dir)
         [ "$#" -ge 2 ] || error "--lb-dir requires a value"
         lb_dir="$2"
         shift 2
         ;;
      --rootfs)
         [ "$#" -ge 2 ] || error "--rootfs requires a value"
         rootfs_dir="$2"
         shift 2
         ;;
      --base-sources)
         [ "$#" -ge 2 ] || error "--base-sources requires a value"
         base_sources_file="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || error "--arch requires a value"
         arch="$2"
         shift 2
         ;;
      --suite)
         [ "$#" -ge 2 ] || error "--suite requires a value"
         suite="$2"
         shift 2
         ;;
      *)
         error "unexpected argument: $1"
         ;;
   esac
done

## Copy a deb822 sources file, adding 'Trusted: yes' to every stanza that
## lacks it. The derivative sources are served over the localhost approx
## proxy (127.0.0.1:9977) and a local file repo -- trusted build-environment
## sources. The old live-build flow authenticated them with an imported key,
## but trixie's apt verifies with 'sqv' (sequoia), which is stricter than the
## legacy 'gpgv' and rejected the developers-repo key the old flow imported.
## Marking these localhost sources trusted (as the local-repo source already
## is) is the robust equivalent; the Debian base keeps full signature
## verification via its Signed-By keyring.
add_trusted_to_sources() {
   local infile="$1" outfile="$2"
   local line stanza=""

   : > "${outfile}"
   ## Read stanza by stanza (deb822 paragraphs separated by blank lines).
   ## '|| [ -n "$line" ]' emits a final stanza with no trailing newline.
   flush_stanza() {
      [ -n "${stanza}" ] || return 0
      printf '%s\n' "${stanza}" >> "${outfile}"
      if ! printf '%s\n' "${stanza}" | grep --quiet --ignore-case '^Trusted:'; then
         printf '%s\n' "Trusted: yes" >> "${outfile}"
      fi
      printf '%s\n' "" >> "${outfile}"
      stanza=""
   }
   while IFS="" read -r line || [ -n "${line}" ]; do
      if [ -z "${line}" ]; then
         flush_stanza
      else
         stanza="${stanza:+${stanza}
}${line}"
      fi
   done < "${infile}"
   flush_stanza
}

main() {
   [ -n "${lb_dir}" ] || error "--lb-dir is required."
   [ -n "${rootfs_dir}" ] || error "--rootfs is required."
   [ -n "${base_sources_file}" ] || error "--base-sources is required."
   [ -n "${arch}" ] || error "--arch is required."
   [ -n "${suite}" ] || error "--suite is required."
   [ -d "${lb_dir}/config" ] || error "'${lb_dir}/config' does not exist; run 'lb config' first."
   [ -r "${base_sources_file}" ] || error "base sources '${base_sources_file}' not readable."

   ## mmdebstrap bootstraps (extracts the Essential set) from the mirror
   ## argument BEFORE any setup-hook runs. So ONLY the signed Debian base
   ## sources go there; the derivative's own extra sources (local repo,
   ## remote derivative) are added by a setup-hook that runs AFTER the base
   ## bootstrap, together with their pins. This mmdebstrap invocation builds
   ## ONLY the base rootfs: the package install is the heavy lifting and is
   ## done by 'build-steps.d/*_create-lb-iso' against the adopted chroot,
   ## using the derivative's own chroot tooling (the same tooling the raw/VM
   ## path's 'build-steps.d/*_install-packages' uses). live-build then only
   ## packs the ISO.
   local derivative_sources_hook chroot_source src_body pref_body staged staging_dir
   src_body=""
   pref_body=""
   ## Stage the derivative sources with 'Trusted: yes' added; the setup-hook
   ## copies the staged (trusted) files into the rootfs. Trusted because these
   ## are localhost build-environment sources (approx proxy / local file repo)
   ## and trixie's 'sqv' verifier is stricter than the legacy 'gpgv' the old
   ## flow relied on. The Debian base keeps full signature verification.
   staging_dir="$(mktemp -d)"
   shopt -s nullglob
   for chroot_source in "${lb_dir}"/config/archives/*.sources.chroot; do
      staged="${staging_dir}/$(basename -- "${chroot_source}" .chroot)"
      add_trusted_to_sources "${chroot_source}" "${staged}"
      src_body="${src_body}cp -- \"${staged}\" \"\$1/etc/apt/sources.list.d/$(basename -- "${staged}")\"
"
   done
   for chroot_source in "${lb_dir}"/config/archives/*.pref.chroot; do
      pref_body="${pref_body}cp -- \"${chroot_source}\" \"\$1/etc/apt/preferences.d/$(basename -- "${chroot_source}" .chroot)\"
"
   done
   shopt -u nullglob
   derivative_sources_hook="set -e
mkdir -p \"\$1/etc/apt/sources.list.d\" \"\$1/etc/apt/preferences.d\"
${src_body}${pref_body}true"

   safe-rm --recursive --force -- "${rootfs_dir}"
   mkdir --parents -- "${rootfs_dir}"

   true "INFO: Building live rootfs base with mmdebstrap into '${rootfs_dir}'..."
   ## Bootstrap from the signed Debian base ('${base_sources_file}'); the
   ## derivative sources+pins are added by 'derivative_sources_hook' so the
   ## adopted chroot has working apt for the package install '2800' runs later.
   ## '--variant=minbase' matches live-build's bootstrap variant;
   ## SOURCE_DATE_EPOCH (exported by help-steps/variables) makes the rootfs
   ## reproducible.
   # shellcheck disable=SC2086
   $SUDO_TO_ROOT ${UNSHARE_PID_NS:-} mmdebstrap \
      --variant=minbase \
      --architectures="${arch}" \
      --components='main contrib non-free non-free-firmware' \
      --setup-hook="${derivative_sources_hook}" \
      --format=directory \
      "${suite}" \
      "${rootfs_dir}" \
      "${base_sources_file}"

   safe-rm --recursive --force -- "${staging_dir}"

   ## Sanity test: the base rootfs must have a package database. There is no
   ## kernel yet -- the kernel is part of the package set '2800' installs into
   ## the adopted chroot.
   $SUDO_TO_ROOT test -f "${rootfs_dir}/var/lib/dpkg/status" \
      || error "live rootfs base has no dpkg status database."

   sync
   true "INFO: live rootfs base built. Seed it with 'help-steps/lb-seed-rootfs-cache'."
}

main "$@"
