## AI-Assisted

## Build the live-ISO root filesystem with the derivative's OWN bootstrap +
## package-install toolchain (mmdebstrap), instead of letting live-build
## re-bootstrap and re-install a second, parallel root filesystem via
## 'lb bootstrap' + 'lb chroot'. The result is seeded into live-build's
## bootstrap cache (see 'help-steps/lb-seed-rootfs-cache') so 'lb bootstrap'
## adopts it and live-build is left doing only what it is uniquely good at:
## the BIOS+EFI bootloader matrix, squashfs, and hybrid-ISO packing
## ('lb binary').
##
## To stay faithful to the intricate, per-architecture live-build package
## and source configuration WITHOUT duplicating it, this reads live-build's
## OWN generated config as the source of truth:
##   - config/package-lists/*.list.chroot   -> the package set (--include)
##   - config/archives/*.sources.chroot     -> the extra apt sources
##                                             (derivative local repo,
##                                              fasttrack, remote derivative)
##   - config/archives/*.pref.chroot        -> apt pins (e.g. calamares from
##                                             backports)
## plus the base Debian bootstrap sources live-build already assembled into
## the caller-provided '--base-sources' file. 'build-steps.d/*_create-lb-iso'
## generates all of that via 'lb config' before calling this.
##
## Bootloader packages are intentionally NOT special-cased here: whichever
## signed/unsigned bootloader packages the live-build package list selected
## for this architecture are installed into the rootfs as data; the actual
## bootloader is written into the ISO by 'lb binary'. mmdebstrap installs
## packages in a chroot with no disk device, so a package whose postinst
## needs a real disk (plain 'grub-pc') must not be in the list -- the
## live-build lists already use '*-bin' / signed variants for that reason.
##
## Usage:
##   build-live-rootfs --lb-dir <dir> --rootfs <dir> --base-sources <file> \
##                     --arch <arch> --suite <suite>

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

## Tolerate this script's own options in 'variables' -> 'parse-cmd'
## (source-run mode makes parse-cmd break, not exit, on unknown options).
## Same idiom as 'help-steps/analyze_image' and 'help-steps/lb-seed-rootfs-cache'.
dist_build_source_run="true"

source "$MYDIR/pre"
source "$MYDIR/variables"

lb_dir=""
rootfs_dir=""
base_sources_file=""
arch=""
suite=""

while [ "$#" -gt 0 ]; do
   case "$1" in
      --lb-dir)
         [ "$#" -ge 2 ] || error "--lb-dir requires a value"
         lb_dir="$2"
         shift 2
         ;;
      --rootfs)
         [ "$#" -ge 2 ] || error "--rootfs requires a value"
         rootfs_dir="$2"
         shift 2
         ;;
      --base-sources)
         [ "$#" -ge 2 ] || error "--base-sources requires a value"
         base_sources_file="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || error "--arch requires a value"
         arch="$2"
         shift 2
         ;;
      --suite)
         [ "$#" -ge 2 ] || error "--suite requires a value"
         suite="$2"
         shift 2
         ;;
      *)
         error "unexpected argument: $1"
         ;;
   esac
done

## Copy a deb822 sources file, adding 'Trusted: yes' to every stanza that
## lacks it. The derivative sources are served over the localhost approx
## proxy (127.0.0.1:9977) and a local file repo -- trusted build-environment
## sources. The old live-build flow authenticated them with an imported key,
## but trixie's apt verifies with 'sqv' (sequoia), which is stricter than the
## legacy 'gpgv' and rejected the developers-repo key the old flow imported.
## Marking these localhost sources trusted (as the local-repo source already
## is) is the robust equivalent; the Debian base keeps full signature
## verification via its Signed-By keyring.
add_trusted_to_sources() {
   local infile="$1" outfile="$2"
   local line stanza=""

   : > "${outfile}"
   ## Read stanza by stanza (deb822 paragraphs separated by blank lines).
   ## '|| [ -n "$line" ]' emits a final stanza with no trailing newline.
   flush_stanza() {
      [ -n "${stanza}" ] || return 0
      printf '%s\n' "${stanza}" >> "${outfile}"
      if ! printf '%s\n' "${stanza}" | grep --quiet --ignore-case '^Trusted:'; then
         printf '%s\n' "Trusted: yes" >> "${outfile}"
      fi
      printf '%s\n' "" >> "${outfile}"
      stanza=""
   }
   while IFS="" read -r line || [ -n "${line}" ]; do
      if [ -z "${line}" ]; then
         flush_stanza
      else
         stanza="${stanza:+${stanza}
}${line}"
      fi
   done < "${infile}"
   flush_stanza
}

## Collect the package set from live-build's generated chroot package lists,
## in file/line ORDER, one package per line, into '${outfile}'. Order matters:
## the live package list deliberately contains packages that conflict with
## each other (e.g. 'virtualbox-guest-utils' vs the baremetal-gui meta, whose
## dependency 'dist-baremetal-gui-all' Breaks it), and relies on a sequential,
## one-package-per-transaction install where the package listed LATER wins and
## apt removes the earlier conflicting one. This mirrors live-build's own
## 'chroot_install-packages', which for LB_INITRAMFS=dracut-live installs the
## list with 'xargs --max-args 1 ... apt-get install' for exactly this reason.
collect_ordered_list() {
   local outfile="$1"
   local list_glob include_line count=0

   : > "${outfile}"
   shopt -s nullglob
   for list_glob in "${lb_dir}"/config/package-lists/*.list.chroot; do
      while IFS="" read -r include_line; do
         ## Strip a trailing comment and surrounding whitespace.
         include_line="${include_line%%#*}"
         include_line="${include_line#"${include_line%%[![:space:]]*}"}"
         include_line="${include_line%"${include_line##*[![:space:]]}"}"
         [ -n "${include_line}" ] || continue
         printf '%s\n' "${include_line}" >> "${outfile}"
         count=$(( count + 1 ))
      done < "${list_glob}"
   done
   shopt -u nullglob

   if [ "${count}" -eq 0 ]; then
      error "no packages found in ${lb_dir}/config/package-lists/*.list.chroot"
   fi
}

main() {
   local prep_hook kernel_img_conf_src install_hook pkglist_staged

   [ -n "${lb_dir}" ] || error "--lb-dir is required."
   [ -n "${rootfs_dir}" ] || error "--rootfs is required."
   [ -n "${base_sources_file}" ] || error "--base-sources is required."
   [ -n "${arch}" ] || error "--arch is required."
   [ -n "${suite}" ] || error "--suite is required."
   [ -d "${lb_dir}/config" ] || error "'${lb_dir}/config' does not exist; run 'lb config' first."
   [ -r "${base_sources_file}" ] || error "base sources '${base_sources_file}' not readable."

   ## mmdebstrap bootstraps (extracts the Essential set) from the mirror
   ## argument BEFORE any setup-hook runs. So ONLY the signed Debian base
   ## sources go there; the derivative's own extra sources (local repo,
   ## remote derivative) -- some of which are unsigned localhost repos that
   ## authenticate via an imported key -- are added by a setup-hook that
   ## runs AFTER the base bootstrap and BEFORE the '--include' package
   ## install, together with their keys. Putting an unsigned/keyed source in
   ## the mirror argument makes the initial bootstrap 'apt-get update' fail
   ## with "repository is not signed".
   local derivative_sources_hook chroot_source src_body pref_body staged staging_dir
   src_body=""
   pref_body=""
   ## Stage the derivative sources with 'Trusted: yes' added; the setup-hook
   ## copies the staged (trusted) files into the rootfs.
   staging_dir="$(mktemp -d)"
   pkglist_staged="${staging_dir}/packages.chroot"
   collect_ordered_list "${pkglist_staged}"
   shopt -s nullglob
   for chroot_source in "${lb_dir}"/config/archives/*.sources.chroot; do
      staged="${staging_dir}/$(basename -- "${chroot_source}" .chroot)"
      add_trusted_to_sources "${chroot_source}" "${staged}"
      src_body="${src_body}cp -- \"${staged}\" \"\$1/etc/apt/sources.list.d/$(basename -- "${staged}")\"
"
   done
   for chroot_source in "${lb_dir}"/config/archives/*.pref.chroot; do
      pref_body="${pref_body}cp -- \"${chroot_source}\" \"\$1/etc/apt/preferences.d/$(basename -- "${chroot_source}" .chroot)\"
"
   done
   shopt -u nullglob
   derivative_sources_hook="set -e
mkdir -p \"\$1/etc/apt/sources.list.d\" \"\$1/etc/apt/preferences.d\"
${src_body}${pref_body}true"

   safe-rm --recursive --force -- "${rootfs_dir}"
   mkdir --parents -- "${rootfs_dir}"

   ## Install-time customizations that 'build-steps.d/*_create-lb-iso' places
   ## into the chroot BEFORE the package install, so package postinsts behave
   ## during a live build. Because the install now happens here (mmdebstrap),
   ## these must be present before '--include' runs -- a setup-hook does that
   ## (setup-hooks run after the Essential extract, before --include). Kept in
   ## step with '2800' (security-misc skip, dist-base-files live marker,
   ## kernel-img.conf, MOK-suppress, dracut-disable).
   kernel_img_conf_src="${source_code_folder_dist}/live-build-data/live-build-config/live_build_kernel_img_conf"
   test -r "${kernel_img_conf_src}"
   test -r "${source_dkms_suppress_mok_snippet}"
   test -r "${source_dracut_disable_config_snippet}"
   prep_hook="set -e
r=\"\$1\"
mkdir -p \"\$r/var/lib/security-misc\" \"\$r/var/lib/dist-base-files\" \"\$r/etc\" \"\$r/etc/dkms/framework.conf.d\" \"\$r/etc/dracut.conf.d\"
touch \"\$r/var/lib/security-misc/skip_install_check\"
touch \"\$r/var/lib/dist-base-files/live_build\"
cp -- \"${kernel_img_conf_src}\" \"\$r/etc/kernel-img.conf\"
cp -- \"${source_dkms_suppress_mok_snippet}\" \"\$r/etc/dkms/framework.conf.d/90-derivative-maker-build.conf\"
cp -- \"${source_dracut_disable_config_snippet}\" \"\$r/etc/dracut.conf.d/90-derivative-maker-build.conf\""

   ## Install the live package set ONE PACKAGE PER apt transaction, in list
   ## order, instead of a single mmdebstrap '--include'. The live package list
   ## intentionally contains mutually-conflicting packages (see
   ## 'collect_ordered_list') and depends on the later-listed package winning,
   ## with apt removing the earlier conflicting one. A single '--include'
   ## transaction cannot express that: trixie's apt solver (3.0) treats every
   ## '--include' package as a hard must-install and aborts on the conflict
   ## ("Reached two conflicting decisions"). Running 'apt-get install' once per
   ## package (via 'xargs --max-args 1', exactly as live-build's
   ## 'chroot_install-packages' does for LB_INITRAMFS=dracut-live) lets each
   ## later package's Breaks/Conflicts remove the earlier one. A customize-hook
   ## runs after the setup-hooks (sources, keys, pins, prep files) are in place,
   ## in mmdebstrap's fully-prepared chroot, so package postinsts behave exactly
   ## as they do under a normal '--include' install.
   ## The staged package list is fed to the in-chroot 'xargs' via stdin (read
   ## on the host, piped in), so nothing is written into or removed from the
   ## chroot by this hook.
   install_hook="set -e
r=\"\$1\"
chroot \"\$r\" apt-get -o Acquire::Retries=5 update
chroot \"\$r\" sh -c 'xargs --max-args 1 apt-get -o Apt::Install-Recommends=false -o Dpkg::Options::=--force-confnew -o Acquire::Retries=5 --yes --allow-remove-essential install' < \"${pkglist_staged}\""

   true "INFO: Building live rootfs with mmdebstrap into '${rootfs_dir}'..."
   ## Bootstrap from the signed Debian base ('${base_sources_file}'); the
   ## derivative sources+keys+pins are added by 'derivative_sources_hook', the
   ## install-time files by 'prep_hook', then 'install_hook' installs the full
   ## live package set one-by-one (see above). '--variant=minbase' matches
   ## live-build's bootstrap variant; SOURCE_DATE_EPOCH (exported by
   ## help-steps/variables) makes the rootfs reproducible.
   # shellcheck disable=SC2086
   $SUDO_TO_ROOT ${UNSHARE_PID_NS:-} mmdebstrap \
      --variant=minbase \
      --architectures="${arch}" \
      --components='main contrib non-free non-free-firmware' \
      --setup-hook="${derivative_sources_hook}" \
      --setup-hook="${prep_hook}" \
      --customize-hook="${install_hook}" \
      --format=directory \
      "${suite}" \
      "${rootfs_dir}" \
      "${base_sources_file}"

   safe-rm --recursive --force -- "${staging_dir}"

   ## Sanity test: the rootfs must have a package database and a kernel
   ## (the live package list installs linux-image).
   test -f "${rootfs_dir}/var/lib/dpkg/status"
   if ! ls "${rootfs_dir}"/boot/vmlinuz-* >/dev/null 2>&1; then
      error "live rootfs has no kernel (/boot/vmlinuz-*); check the live-build package list."
   fi

   sync
   true "INFO: live rootfs built. Seed it with 'help-steps/lb-seed-rootfs-cache'."
}

main "$@"
