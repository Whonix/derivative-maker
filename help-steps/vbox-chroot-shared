## AI-Assisted

## Shared plumbing for the VBox cowbuilder chroot scripts
## ('pbuilder-chroot-script-create-vbox-vm',
## 'pbuilder-chroot-script-export-vbox-vm'): root-privilege handling,
## 'error', failure diagnostics (installed as an ERR trap at source time),
## VirtualBox daemon shutdown / stale-IPC cleanup, and the 'dm-vbox-temp'
## sudoers setup.
##
## SOURCED, not executed, from inside the cowbuilder chroot. The chroot
## scripts run from the bind-mounted 'help-steps' folder (host and chroot
## paths are identical), so they resolve this file as a sibling of their
## own '${BASH_SOURCE[0]}'. Like 'help-steps/retry-run', this file must
## stay dependency-minimal: 'help-steps/pre' (colors, exception handlers,
## helper-scripts sources) is NOT available inside the chroot.
##
## Expects the sourcing script to have set the strict-mode block ('set -o
## errexit' etc. including 'errtrace', so the ERR trap installed below
## inherits into functions) and to have verified its required environment
## variables ('HOMEVAR_VBOX_TEMP' in particular) beforehand.
##
## No strict-mode preamble: this file is only ever sourced, so 'set -o
## errexit' etc. would leak into the sourcing shell (R-010 exempts sourced
## libraries; same as 'help-steps/retry-run').
## style-ok: no-strict

## This code runs as root inside the cowbuilder chroot (via
## 'cowbuilder --execute'), so 'sudo' to root is redundant. Worse, sudo's
## 'env_reset' drops 'COWDANCER_ILISTFILE' while cowbuilder's 'libcowdancer'
## remains LD_PRELOAD'ed, leaving the copy-on-write layer half-initialized so
## that root file operations fail with 'cp: ... Cannot allocate memory'. Run
## root commands directly (without sudo) so the inherited cowdancer
## environment stays intact. '$SUDO_TO_VBOX_TEMP' is deliberately NOT cleared
## here: it must drop privileges to the 'dm-vbox-temp' account whose
## VirtualBox registry holds the VM.
SUDO_TO_ROOT=""

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 1
}

## Dump chroot state that past failures needed: disk space (a full disk can
## make 'VBoxSVC' fail to start with only 'Failed to create the VirtualBox
## object!' as the symptom), memory, stale VirtualBox XPCOM IPC state in
## '/tmp' (persisted into 'base.cow' by a previous VBox chroot session via
## '--save-after-login' and hardlink-copied into this one), any VirtualBox
## processes still alive from that previous session, and the 'VBoxSVC.log'
## of the 'dm-vbox-temp' account. Called once at startup (baseline for
## comparing a failed run against a green one) and again from the ERR trap
## at the moment of failure. Every command is '|| true'-guarded: diagnostics
## must never turn into the failure themselves.
diagnostics_dump() {
   true "INFO: diagnostics: locale: LC_ALL='${LC_ALL:-}' LANG='${LANG:-}' LANGUAGE='${LANGUAGE:-}'"
   true "INFO: diagnostics: temp dir env: TMPDIR='${TMPDIR:-}' TMP='${TMP:-}'"

   true "INFO: diagnostics: disk space (all filesystems visible inside the chroot):"
   df --human-readable || true
   df --inodes || true

   true "INFO: diagnostics: memory:"
   head --lines=5 -- /proc/meminfo || true

   true "INFO: diagnostics: VirtualBox XPCOM IPC state under '/tmp':"
   find /tmp/ -mindepth 1 -maxdepth 2 -path '/tmp/.vbox*' -exec ls -l -a -d -- {} \; || true

   true "INFO: diagnostics: VirtualBox processes (as visible in this PID namespace):"
   pgrep --list-full -- "[Vv][Bb]ox" || true

   true "INFO: diagnostics: '${HOMEVAR_VBOX_TEMP}/.config/VirtualBox':"
   ls -l -a -- "${HOMEVAR_VBOX_TEMP}/.config/VirtualBox/" || true
   tail --lines=100 -- "${HOMEVAR_VBOX_TEMP}/.config/VirtualBox/VBoxSVC.log" || true
}

diagnostics_on_error() {
   ## The ERR trap re-fires while a failure propagates up through function
   ## calls under 'errtrace'; dump only once.
   if [ "${diagnostics_on_error_done}" = "true" ]; then
      return 0
   fi
   diagnostics_on_error_done=true

   true "ERROR-DIAG: a command failed; dumping chroot diagnostics."
   diagnostics_dump

   ## '--save-after-login' persists this chroot into 'base.cow' even when the
   ## session fails; shut the VirtualBox daemons down cleanly so a retry does
   ## not inherit stale runtime state on top of the failure.
   vboxsvc_shutdown
}

diagnostics_on_error_done=false
trap diagnostics_on_error ERR

## Print the PIDs of the VirtualBox XPCOM daemons ('VBoxSVC',
## 'VBoxXPCOMIPCD') whose process root is THIS chroot. The chroot shares
## its PID namespace with the invoking build step (a private one: the host
## wrapper runs cowbuilder under 'unshare --pid --fork'), so a bare name
## match could still hit VirtualBox processes outside the chroot (e.g.
## cowbuilder-side helpers, or everything on the host if the wrapper ever
## runs without 'unshare'); comparing '/proc/<pid>/root' against '/' by
## device:inode scopes the match to daemons started from this very
## session.
vbox_daemon_pid_list() {
   local chroot_root_id pgrep_output daemon_pid proc_root_id

   chroot_root_id="$(stat --format "%d:%i" -- /)"
   pgrep_output="$(pgrep --full -- "VBoxSVC|VBoxXPCOMIPCD")" || pgrep_output=""
   for daemon_pid in ${pgrep_output}; do
      ## The daemon may exit between 'pgrep' and 'stat'; skip it then.
      ## '--dereference' is required: '/proc/<pid>/root' is a (magic)
      ## symlink, and by default 'stat' reports the symlink inode itself,
      ## not the root directory it points to.
      proc_root_id="$(stat --dereference --format "%d:%i" -- "/proc/${daemon_pid}/root" 2>/dev/null)" || continue
      if [ "${proc_root_id}" = "${chroot_root_id}" ]; then
         printf '%s\n' "${daemon_pid}"
      fi
   done
}

## Remove VirtualBox XPCOM IPC runtime state ('/tmp/.vbox-<user>-ipc' of both
## 'dm-vbox-temp' and root, the latter created by 'VBoxManage import
## --dry-run' in the export step). Called at session start (state a previous
## session persisted into 'base.cow' via '--save-after-login' arrives here
## as 'cp --link' hardlinks; unlinking detaches this session from the shared
## socket inode even if the previous session's daemon is somehow still
## alive) and at session end (so nothing stale is persisted for the NEXT
## session).
##
## The literal '/tmp' is correct even where 'TMPDIR' is redirected (e.g. by
## 'libpam-tmpdir', which this chroot does not have): VirtualBox hardcodes
## the socket path prefix, see 'kDefaultSocketPrefix' ("/tmp/.vbox-") in
## VirtualBox 'src/libs/xpcom18a4/ipc/ipcd/shared/src/ipcConfig.cpp';
## 'TMPDIR'/'TMP' are never consulted for it.
vbox_stale_ipc_cleanup() {
   safe-rm --recursive --force -- /tmp/.vbox-*-ipc
}

## Cleanly shut down this chroot session's VirtualBox XPCOM daemons before
## the cowbuilder session ends. 'VBoxSVC' lingers for around 5 seconds after
## its last client exits; if it is still alive during cowbuilder teardown it
## dies uncleanly (or keeps running against the moved directory) and
## '--save-after-login' persists its stale IPC socket and lock into
## 'base.cow' -- a suspected cause of the intermittent 'VBoxManage: error:
## Failed to create the VirtualBox object!' CI failure. SIGTERM is the clean
## path ('VBoxSVC' flushes its registry and removes its IPC socket); SIGKILL
## is a last resort. The IPC cleanup afterwards leaves 'base.cow' clean
## either way.
vboxsvc_shutdown() {
   local daemon_pid_list wait_counter

   daemon_pid_list="$(vbox_daemon_pid_list)"
   if [ -n "${daemon_pid_list}" ]; then
      true "INFO: Shutting down VirtualBox daemons cleanly (SIGTERM): ${daemon_pid_list}"
      ## Word-splitting of '$daemon_pid_list' is intentional (one PID per line).
      # shellcheck disable=SC2086
      kill -s TERM -- ${daemon_pid_list} || true

      wait_counter=0
      while [ -n "$(vbox_daemon_pid_list)" ]; do
         wait_counter=$((wait_counter + 1))
         if [ "${wait_counter}" -gt 15 ]; then
            break
         fi
         sleep 1
      done
   fi

   daemon_pid_list="$(vbox_daemon_pid_list)"
   if [ -n "${daemon_pid_list}" ]; then
      printf '%s\n' "WARNING: VirtualBox daemons survived SIGTERM, sending SIGKILL: ${daemon_pid_list}" >&2
      # shellcheck disable=SC2086
      kill -s KILL -- ${daemon_pid_list} || true
      sleep 1
   fi

   vbox_stale_ipc_cleanup
}

setup_vbox_temp_sudo() {
   ## '$SUDO_TO_VBOX_TEMP' runs 'sudo --chdir' (-D), which sudo refuses
   ## unless the policy permits 'runcwd'. On the build host that rule is
   ## installed by 'build-steps.d/*_prepare-build-machine'; inside this
   ## chroot it must be installed here. The chroot scripts run as root (via
   ## 'cowbuilder --execute'), so the invoking user is root and a global
   ## 'Defaults runcwd=*' is the matching rule. 'sponge' (used on the host)
   ## may be absent in the chroot, so use 'tee' (as
   ## 'pbuilder-chroot-script-virtualbox' does).
   ##
   ## The 'env_keep' rule lets the deterministic locale trio passed in from
   ## 'help-steps/variables' (LC_ALL, LANG, LANGUAGE) survive sudo's
   ## 'env_reset' into the 'dm-vbox-temp' commands (default sudo strips all
   ## three).
   printf '%s\n' "Defaults runcwd=*" 'Defaults env_keep += "LC_ALL LANG LANGUAGE"' \
      | SUDO_EDITOR="" VISUAL="" EDITOR=tee visudo -f /etc/sudoers.d/dm-vbox-temp-runcwd >/dev/null

   ## Sanity test.
   visudo --strict --check /etc/sudoers.d/dm-vbox-temp-runcwd
}
