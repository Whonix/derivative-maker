## AI-Assisted

## Verify a built image reproduces, by comparing it against a reference build
## with diffoscope (via 'help-steps/reproducible-compare').
##
## Image reproducibility is verified the way Debian and Tails do it (there is
## no upstream image-level rebuilder daemon; rebuilderd et al. are package/
## archive-oriented): build the image (at least) twice under the same pinned
## inputs -- SOURCE_DATE_EPOCH, frozen snapshot.debian.org sources,
## strip-nondeterminism, dracut --reproducible, all already set elsewhere --
## and diffoscope the two outputs. diffoscope descends ISO 9660 / squashfs /
## raw / qcow2 / OVA natively, so this step is a THIN driver around it; it does
## not re-implement image dissection (that was the retired, 1200-line
## 'help-steps/analyze_image' + its per-file stat+sha512 manifest scheme).
##
## Point 'dist_build_reproducible_reference_folder' at a reference build's
## output folder; each built artifact is compared against the same-named
## artifact there. Without a reference set, this is a no-op (build a reference
## first, then rebuild with the reference configured).
##
## Differences are RECORDED (a '.diffoscope' report next to the artifact), not
## treated as a build failure here -- current live images are not yet fully
## bit-reproducible upstream either. CI can gate on the report / exit code.
##
## For OUR OWN .deb reproducibility, use Debian's debrebuild(1) (rebuild from
## the package '.buildinfo' against the pinned snapshot) or reprotest(1) -- not
## this step, which is for the final disk/ISO images.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd "$MYDIR"
cd ..
cd help-steps

source pre
source variables

## Compare one built artifact against its counterpart in the reference folder.
compare_target() {
   local target artifact reference_artifact report_out compare_exit_code
   target="$1"
   artifact="$2"

   if [ ! -f "$artifact" ]; then
      true "${cyan}INFO: no $target artifact at '$artifact', skipping.${reset}"
      return 0
   fi

   reference_artifact="${dist_build_reproducible_reference_folder}/$(basename -- "$artifact")"
   if [ ! -f "$reference_artifact" ]; then
      true "${cyan}INFO: no reference $target artifact at '$reference_artifact', skipping compare.${reset}"
      return 0
   fi

   report_out="$binary_build_folder_dist/$(basename -- "$artifact").diffoscope.txt"
   true "${cyan}INFO: comparing $target build vs reference with diffoscope...${reset}"

   ## reproducible-compare returns 1 when the artifacts differ; record it, do
   ## not fail the build on non-reproducibility.
   compare_exit_code="0"
   "$dist_source_help_steps_folder/reproducible-compare" \
      --output "$report_out" \
      "$reference_artifact" \
      "$artifact" \
      || compare_exit_code="$?"

   if [ "$compare_exit_code" = "0" ]; then
      true "${bold}${green}INFO: $target reproducible: identical to the reference build.${reset}"
   elif [ "$compare_exit_code" = "1" ]; then
      true "${bold}${red}WARNING: $target differs from the reference build; see '$report_out'.${reset}"
   else
      error "reproducible-compare failed for $target (exit $compare_exit_code)."
   fi
}

main() {
   if [ "${build_dry_run:-}" = "true" ]; then
      true "${bold}${cyan}INFO: dry-run, skipping ${BASH_SOURCE[0]}. ${reset}"
      return 0
   fi

   if [ "${dist_build_fast2:-}" = "1" ]; then
      printf '%s\n' "${bold}${cyan}INFO: run with '--fast 2' switch, skipping ${BASH_SOURCE[0]}. ${reset}"
      return 0
   fi

   if [ ! "${dist_build_script_create_report:-}" = "true" ]; then
      true "${bold}${cyan}INFO: run without --report true, skipping, ok. ${reset}"
      return 0
   fi

   if [ "${dist_build_reproducible_reference_folder:-}" = "" ]; then
      true "${bold}${cyan}INFO: dist_build_reproducible_reference_folder is unset, so there is no reference \
build to compare against; skipping. To verify reproducibility, build a reference, then rebuild with \
dist_build_reproducible_reference_folder pointing at it (or run 'help-steps/reproducible-compare' on two \
build outputs directly).${reset}"
      return 0
   fi

   if [ "${dist_build_raw:-}" = "true" ]; then
      compare_target "raw" "$binary_image_raw_file"
   fi

   if [ "${dist_build_virtualbox:-}" = "true" ]; then
      compare_target "ova" "$binary_image_ova_file"
   fi

   if [ "${dist_build_qcow2:-}" = "true" ]; then
      compare_target "qcow2" "$binary_image_qcow2_file"
   fi

   if [ "${dist_build_iso:-}" = "true" ]; then
      compare_target "iso" "$binary_image_iso_file"
   fi
}

main "$@"
